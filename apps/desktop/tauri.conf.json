{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperComposer",
  "identifier": "io.github.ellrin.papercomposer",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../ui": "ui",
      "../../workspace-template": "workspace-template"
    }
  }
}
